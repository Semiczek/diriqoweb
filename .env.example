# Copy to .env.local; never commit actual credentials.
# Existing app/auth variables remain unchanged.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Enable only after applying and testing database/waitlist-setup.sql
# and verifying the privacy notice and daily retention maintenance.
WAITLIST_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=
# A random secret of at least 32 characters. Server-only.
WAITLIST_RATE_LIMIT_SALT=
